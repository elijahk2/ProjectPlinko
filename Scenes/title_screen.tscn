[sub_resource type="GDScript" id="GDScript_rxejw"]
resource_name = "titlescreen"
script/source = "extends Control

#NOTE: Would be nice to remove hardcoded positioning values for label movement

var cursor_y = 1
var cursor_x = 1
var is_title_ended = false
var text_vel = 0

var title_header_done = false #Handles movement of headers offscreen
var title_header_vel = 0
var play_label_done = false
var play_label_vel = 0
var cursor_vel = 0
var rotation_speed = 4
var scale_diff = 0.13 #Default scale for discord icon
var scale_direction = 1 #Direction to scale the discord icon

@onready var cursor: Sprite2D = $Cursor
@onready var audio_stream_player: AudioStreamPlayer = $AudioStreamPlayer
@onready var cursor_move_sfx: AudioStreamPlayer = $CursorMoveSFX
@onready var title_screen_balls = preload(\"res://Scenes/title_screen_balls.tscn\")
@onready var lower_bound: CollisionShape2D = $\"World Floor/Lower Bound\"

@onready var title_header: Label = $TitleHeader
@onready var play_label: Label = $PlayLabel
@onready var leaderboard_label: Label = $LeaderboardLabel
@onready var quit_label: Label = $QuitLabel
@onready var skins_label: Label = $SkinsLabel

@onready var settings_icon: Sprite2D = $SettingsIcon
@onready var discord_icon: Sprite2D = $DiscordIcon

		
func _ready():
	Engine.time_scale = 1 #Set to normal speed unless ur psycho
	Globals.num_balls = 0 #Reset count of balls on screen
	#DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_MAXIMIZED)
	DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN)
	DisplayServer.window_set_size(Vector2i(375, 750))
	for i in 26:
		spawn_title_ball()
		
func spawn_title_ball():
	var ball = title_screen_balls.instantiate()
	self.move_child(ball, 0) # This moves the ball to the first index, drawing it BEHIND other UI
	ball.position = Vector2(randi_range(0, 375), randi_range(-10, -400)) #Randomly position the balls at the top of the screen to drop at random intervals.
	self.add_child(ball)
	Globals.change_ball_num(1)
		
func _process(delta):
	if is_title_ended == false:
		if cursor_y < 5: #manage whether the user is on the main options or the taskbar below
			cursor.show()
			if cursor_y == 1:
				cursor.position = Vector2(289,431) #Hardcoded positions to display cursor at.
			elif cursor_y == 2:
				cursor.position = Vector2(289,485) # \" \"
			elif cursor_y == 3:
				cursor.position = Vector2(289, 539)
			else:
				cursor.position = Vector2(289, 593)
		else:
			cursor.hide()
		if cursor_y == 5: #manage taskbar
			if Input.is_action_just_pressed(\"right\") and cursor_x < 2:
				cursor_x += 1
			if Input.is_action_just_pressed(\"left\") and cursor_x > 1:
				cursor_x -= 1
			if cursor_x == 1:
				discord_icon.scale = Vector2(0.13, 0.13) #Default scale for the discord icon
				settings_icon.rotate(rotation_speed)
			else:
				settings_icon.rotation_degrees = 0
				discord_icon.scale = Vector2(scale_diff, scale_diff)
				scale_diff += scale_direction * scale_diff * delta
				if scale_diff > 0.16: #Monitor size of discord icon to switch direction of scaling
					scale_direction = -1
				elif scale_diff < 0.1:
					scale_direction = 1
				
		if Input.is_action_just_pressed(\"down\") and cursor_y < 5 or Input.is_action_just_pressed(\"up\") and cursor_y > 1:
			spawn_title_ball()
		if Input.is_action_just_pressed(\"push\"):
			if cursor_y == 1 and is_title_ended == false:
				Globals.play_cursor_move_sfx()
				end_title()
			elif cursor_y == 2:
				Globals.play_cursor_move_sfx()
				get_tree().change_scene_to_file(\"res://Scenes/leaderboards.tscn\")
			elif cursor_y == 3:
				Globals.play_cursor_move_sfx()
				get_tree().change_scene_to_file(\"res://Scenes/skins.tscn\")
			elif cursor_y == 4:
				get_tree().quit()
			else:
				if cursor_x == 1:
					get_tree().change_scene_to_file(\"res://Scenes/settings.tscn\")
				elif cursor_x == 2:
					OS.shell_open(\"https://discord.gg/R4JrmDj5n2\")
		elif Input.is_action_just_pressed(\"down\") and cursor_y < 5:
			cursor_y += 1
			Globals.play_cursor_move_sfx()
		elif Input.is_action_just_pressed(\"up\") and cursor_y > 1:
			cursor_y -= 1
			Globals.play_cursor_move_sfx()
		if Input.is_action_just_pressed(\"back\"): #End game
			get_tree().quit()
	if is_title_ended == true and title_header.position.x > -400:
		title_header_vel += 10
		title_header.position.x -= title_header_vel * delta
		if title_header.position.x < -150:
			title_header_done = true
	if title_header_done == true:
		play_label_vel += 10
		play_label.position.x -= play_label_vel * delta
		leaderboard_label.position.x -= play_label_vel / 2 * delta
		cursor.position.y += 5 * play_label_vel / 2 * delta
		quit_label.position.x -= play_label_vel / 3 * delta
		skins_label.position.x -= play_label_vel / 4 * delta
		if Globals.num_balls == 0 and skins_label.position.x < -250 and cursor.position.y > 850:
			play_label_done = true
			get_tree().change_scene_to_file(\"res://Scenes/modifier_choice.tscn\")

func end_title():
	is_title_ended = true
	lower_bound.set_deferred(\"disabled\", true)
	#get_tree().change_scene_to_file(\"res://Scenes/modifier_choice.tscn\")
"

